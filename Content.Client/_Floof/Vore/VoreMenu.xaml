<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="Vore Settings"
    MinSize="400 200">
    <TabContainer Name="MasterTabContainer">
        <BoxContainer Name="Consent" Orientation="Vertical" SeparationOverride="8">
            <BoxContainer Orientation="Vertical" SeparationOverride="6">
                <Label Text="Pred / Prey Settings" />
                <CheckBox Name="AllowPred" Text="Allow being a predator" />
                <CheckBox Name="AllowPrey" Text="Allow being prey" />
            </BoxContainer>
            <BoxContainer Orientation="Vertical" SeparationOverride="6" Name="DigestBox">
                <Label Text="Vore Types" />
                <CheckBox Name="Digest" Text="Classic digestion" />
            </BoxContainer>
        </BoxContainer>
        <BoxContainer Name="Customization" Orientation="Vertical" SeparationOverride="8">
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Text="Stomach rgb" VerticalAlignment="Center" />
                <SpinBox  Name="ValueA" MinSize="40 0" />
                <SpinBox  Name="ValueB" MinSize="40 0" />
                <SpinBox  Name="ValueC" MinSize="40 0"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Text="Digestion speed" VerticalAlignment="Center" />
                <SpinBox Name="DigestSpeed"/>
            </BoxContainer>
        </BoxContainer>
        <BoxContainer Name="Options" Orientation="Vertical" SeparationOverride="6">
                <CheckBox Name="AllowSound" Text="Stomach sounds" />
        </BoxContainer>
    </TabContainer>
</DefaultWindow>
